#!/usr/bin/env python3
"""dirvec session 27, part A (BRIEF.md, session 27): the folders, targets and tool for queries written by a person.

  humanq_tool.py sample  --index E1=data/emb/jina-embeddings-v4_s11/index.jsonl,E2=...,E3=...,E4=... \
                         [--out data/humanq_sample_s11.jsonl] [--check]
  humanq_tool.py payload [--sample data/humanq_sample_s11.jsonl] [--out build/humanq/payload_s11.json.gz]
  humanq_tool.py html    [--payload build/humanq/payload_s11.json.gz] [--out build/humanq/humanq_s11.html] [--limit N]

sample (fixed by the brief, nothing chosen on an outcome):
- Eligible folder: an S11 folder of the evaluation split (calibration seed 20261102), ranked (three files or
  more), outside the four digitization series of session 17, with at least two files labelled image and at
  least two text-like files (text, table, pdf_text, other) that are possible targets. A possible target is
  an S11 evaluation query under E1 (a file with an E1 vector that build_gt.py kept as a query) that has a
  vector under E2, E3 and E4 too.
- Draw: numpy default_rng(270501); per bucket in the order [0,.2), [.8,1], [.2,.5), [.5,.8), a permutation
  of the bucket's eligible folders sorted by path, walked in order; a folder is taken unless its family
  (first creator, lowercased) is already in the sample; 30 per bucket.
- Tool order: the folders cycle through the buckets [0,.2), [.2,.5), [.5,.8), [.8,1], each bucket's in
  draw order, so any first 4n folders hold n per bucket. Keys F001 to F120 in that order.
- Targets: default_rng(270502), per folder in tool order, a permutation of its possible image targets and
  one of its possible text-like targets (each list sorted by path first). Display: default_rng(270503), per
  folder in tool order, a permutation of the folder's files with an E1 vector (manifest order first).
--check rebuilds the sample and compares it byte for byte with the file (the 27A gate).

payload: for every file shown, a thumbnail (images through embed.py's load_rgb; scanned PDFs, page one at
embed.py's 100 dpi; longest side 320 pixels, JPEG quality 75) or the first 300 characters of the text
embed.py's prepare() extracts (whitespace collapsed). In text heads, the folder's file names (with their
extension, and stems that hold a character other than a letter or run to ten letters or more) become
"[name]", any run of four or more consecutive words of the record title becomes "[...]", and every digit
becomes "#". The payload holds no path, file name, record identifier, title or description.

html: one self-contained HTML file (no network) for writing two queries per folder, with export and resume.
"""
import argparse
import base64
import gzip
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import tempfile
from collections import Counter

import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)

BUCKETS = ("[0,.2)", "[.2,.5)", "[.5,.8)", "[.8,1]")
DRAW_ORDER = ("[0,.2)", "[.8,1]", "[.2,.5)", "[.5,.8)")
PER_BUCKET = 30
TEXTLIKE = ("text", "table", "pdf_text", "other")
FOUR = {"digital humanities jena", "nona, dronova", "finnish museum of natural history luomus, university of helsinki",
        "royal botanic garden edinburgh"}
SEED_DRAW, SEED_TARGETS, SEED_DISPLAY = 270501, 270502, 270503
CALIB_SEED = 20261102
THUMB, HEAD = 320, 300
LABEL = {"image": "picture", "pdf_scanned": "scanned page", "text": "text", "table": "table", "pdf_text": "PDF text",
         "other": "document"}


def jl(path):
    p = path if os.path.isabs(path) else os.path.join(ROOT, path)
    with (gzip.open(p, "rt") if p.endswith(".gz") else open(p)) as fh:
        return [json.loads(l) for l in fh if l.strip()]


def bucket_of(x):
    return BUCKETS[0] if x < 0.2 else BUCKETS[1] if x < 0.5 else BUCKETS[2] if x < 0.8 else BUCKETS[3]


def calib_split(dirs, frac, seed):
    """eval.py's calib_split (session 8): per bucket, sorted, a random round(frac * n)."""
    calib = set()
    rng = np.random.default_rng(seed)
    for b in BUCKETS:
        ds = sorted(d for d, r in dirs.items() if bucket_of(r["image_frac"]) == b)
        n_cal = int(round(frac * len(ds)))
        calib.update(ds[i] for i in rng.permutation(len(ds))[:n_cal])
    return calib


# ------------------------------------------------------------------ sample
def build_sample(manifest, dirs, gt, selection, ok):
    """The sample rows in tool order, and counts for the log."""
    cal = calib_split(dirs, 0.2, CALIB_SEED)
    row_of = {r["path"]: i for i, r in enumerate(manifest)}
    encs = sorted(ok)
    e1 = ok["E1"]
    queries = set()
    for g in gt:
        i = row_of.get(g["query_path"])
        if i is not None and e1[i] and g["relevant_dir"] not in cal:
            queries.add(g["query_path"])
    sel = {r["id"]: r for r in selection}

    def family(d):
        cr = sel[dirs[d]["record"]].get("creators") or []
        return cr[0].strip().lower() if cr else f"record:{dirs[d]['record']}"

    files_of = {}
    for i, r in enumerate(manifest):
        files_of.setdefault(r["dir"], []).append(i)
    eligible = {b: [] for b in BUCKETS}
    targets = {}
    counts = Counter()
    for d, r in dirs.items():
        if r["n_files"] < 3 or d in cal:
            continue
        b = bucket_of(r["image_frac"])
        counts[("eval", b)] += 1
        if family(d) in FOUR:
            counts[("four", b)] += 1
            continue
        possible = [i for i in files_of.get(d, []) if manifest[i]["path"] in queries and all(ok[e][i] for e in encs)]
        img = sorted(manifest[i]["path"] for i in possible if manifest[i]["modality"] == "image")
        tl = sorted(manifest[i]["path"] for i in possible if manifest[i]["modality"] in TEXTLIKE)
        if len(img) >= 2 and len(tl) >= 2:
            eligible[b].append(d)
            targets[d] = (img, tl)
            counts[("eligible", b)] += 1
    rng = np.random.default_rng(SEED_DRAW)
    drawn = {b: [] for b in BUCKETS}
    fams = set()
    for b in DRAW_ORDER:
        cand = sorted(eligible[b])
        for i in rng.permutation(len(cand)):
            d = cand[int(i)]
            if family(d) in fams:
                continue
            drawn[b].append(d)
            fams.add(family(d))
            if len(drawn[b]) == PER_BUCKET:
                break
    order = []
    for j in range(max(len(v) for v in drawn.values())):
        for b in BUCKETS:
            if j < len(drawn[b]):
                order.append((b, drawn[b][j]))
    rng_t = np.random.default_rng(SEED_TARGETS)
    rng_d = np.random.default_rng(SEED_DISPLAY)
    rows = []
    for n, (b, d) in enumerate(order, 1):
        img, tl = targets[d]
        img = [img[int(i)] for i in rng_t.permutation(len(img))]
        tl = [tl[int(i)] for i in rng_t.permutation(len(tl))]
        shown = [i for i in files_of[d] if e1[i]]
        shown = [shown[int(i)] for i in rng_d.permutation(len(shown))]
        key = f"F{n:03d}"
        fkeys = {manifest[i]["path"]: f"{key}-{k:02d}" for k, i in enumerate(shown, 1)}
        rows.append({"key": key, "order": n, "dir": d, "record": dirs[d]["record"], "bucket": b,
                     "image_frac": dirs[d]["image_frac"], "family": family(d), "n_files": dirs[d]["n_files"],
                     "files": [{"key": fkeys[manifest[i]["path"]], "path": manifest[i]["path"],
                                "modality": manifest[i]["modality"], "sha256": manifest[i]["sha256"]} for i in shown],
                     "targets_QI": [fkeys[p] for p in img], "targets_QT": [fkeys[p] for p in tl]})
    return rows, counts, {b: len(v) for b, v in drawn.items()}


def cmd_sample(args):
    ok = {}
    for item in args.index.split(","):
        e, p = item.split("=", 1)
        ok[e] = np.array([bool(r["ok"]) for r in jl(p)])
    assert set(ok) == {"E1", "E2", "E3", "E4"}, sorted(ok)
    manifest = jl(args.manifest)
    for e, v in ok.items():
        assert len(v) == len(manifest), f"{e}: index and manifest differ in length"
    dirs = {r["dir"]: r for r in jl(args.dirs)}
    rows, counts, drawn = build_sample(manifest, dirs, jl(args.gt), jl(args.selection), ok)
    text = "".join(json.dumps(r, sort_keys=True) + "\n" for r in rows)
    for b in BUCKETS:
        sys.stderr.write(f"{b}: evaluation folders {counts[('eval', b)]}, in the four series {counts[('four', b)]}, "
                         f"eligible {counts[('eligible', b)]}, drawn {drawn[b]}\n")
    out = args.out if os.path.isabs(args.out) else os.path.join(ROOT, args.out)
    if args.check:
        with open(out) as fh:
            same = fh.read() == text
        sys.stderr.write(f"sample check: {'identical' if same else 'DIFFERENT'} ({out})\n")
        return 0 if same else 3
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as fh:
        fh.write(text)
    sys.stderr.write(f"wrote {out}: {len(rows)} folders, sha256 {hashlib.sha256(text.encode()).hexdigest()[:16]}\n")
    return 0


# ------------------------------------------------------------------ payload
WORD = re.compile(r"\w+", re.UNICODE)


def mask_head(text, names, title):
    """The first HEAD characters of a text, whitespace collapsed, names, title runs and digits masked."""
    t = " ".join(text.split())[:HEAD]
    for nm in sorted(names, key=len, reverse=True):
        if len(nm) >= 3:
            t = re.sub(re.escape(nm), "[name]", t, flags=re.IGNORECASE)
    tw = [w.lower() for w in WORD.findall(title)]
    grams = {tuple(tw[i:i + 4]) for i in range(len(tw) - 3)}
    toks = [(m.start(), m.end(), m.group(0).lower()) for m in WORD.finditer(t)]
    cover = [False] * len(toks)
    for i in range(len(toks) - 3):
        if tuple(x[2] for x in toks[i:i + 4]) in grams:
            for j in range(i, i + 4):
                cover[j] = True
    spans, i = [], 0
    while i < len(toks):
        if cover[i]:
            j = i
            while j + 1 < len(toks) and cover[j + 1]:
                j += 1
            spans.append((toks[i][0], toks[j][1]))
            i = j + 1
        else:
            i += 1
    for s, e in reversed(spans):
        t = t[:s] + "[...]" + t[e:]
    return re.sub(r"\d", "#", t)


def mask_names(manifest_rows):
    names = set()
    for r in manifest_rows:
        b = os.path.basename(r["path"])
        names.add(b)
        k = b.rfind(".")
        stem = b[:k] if k > 0 else b
        if re.search(r"[^A-Za-z]", stem) or len(stem) >= 10:
            names.add(stem)
    return names


def thumb_b64(im):
    from PIL import Image
    im = im.convert("RGB")
    im.thumbnail((THUMB, THUMB), Image.LANCZOS)
    buf = io.BytesIO()
    im.save(buf, "JPEG", quality=75, optimize=True)
    return "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()


def first_page(path):
    import embed as em
    with tempfile.TemporaryDirectory() as td:
        subprocess.run(["pdftoppm", "-f", "1", "-l", "1", "-r", str(em.PDF_DPI), "-png", path, os.path.join(td, "p")],
                       capture_output=True, timeout=600)
        pngs = sorted(f for f in os.listdir(td) if f.endswith(".png"))
        return em.load_rgb(os.path.join(td, pngs[0])) if pngs else None


def cmd_payload(args):
    import embed as em
    sample = jl(args.sample)
    manifest = jl(args.manifest)
    by_path = {r["path"]: r for r in manifest}
    by_dir = {}
    for r in manifest:
        by_dir.setdefault(r["dir"], []).append(r)
    titles = {r["id"]: r.get("title") or "" for r in jl(args.selection)}
    folders, n_img, n_txt, fails = [], 0, 0, []
    for s in sample:
        names = mask_names(by_dir[s["dir"]])
        title = titles.get(s["record"], "")
        files = []
        for f in s["files"]:
            row = by_path[f["path"]]
            path = os.path.join(ROOT, row["path"])
            item = {"key": f["key"], "label": LABEL[row["modality"]]}
            try:
                if row["modality"] == "image":
                    item["img"] = thumb_b64(em.load_rgb(path))
                    n_img += 1
                elif row["modality"] == "pdf_scanned":
                    pg = first_page(path)
                    if pg is None:
                        raise RuntimeError("no page rendered")
                    item["img"] = thumb_b64(pg)
                    n_img += 1
                else:
                    kind, t, note = em.prepare(row)
                    if kind != "text":
                        raise RuntimeError(f"prepare gave {kind}: {note}")
                    item["text"] = mask_head(t, names, title)
                    n_txt += 1
            except Exception as e:  # noqa: BLE001
                item["text"] = "(this file could not be shown)"
                fails.append(f"{f['key']}: {repr(e)[:120]}")
            files.append(item)
        folders.append({"key": s["key"], "files": files, "QI": s["targets_QI"], "QT": s["targets_QT"]})
        sys.stderr.write(f"{s['key']} done ({len(files)} files)\n")
    build = hashlib.sha256(open(args.sample, "rb").read()).hexdigest()[:12]
    payload = {"build": build, "folders": folders}
    out = args.out if os.path.isabs(args.out) else os.path.join(ROOT, args.out)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with gzip.open(out, "wt") as fh:
        json.dump(payload, fh)
    sys.stderr.write(f"wrote {out}: {len(folders)} folders, {n_img} thumbnails, {n_txt} text heads, "
                     f"{len(fails)} files not shown{': ' + '; '.join(fails) if fails else ''}; "
                     f"{os.path.getsize(out) / 1e6:.1f} MB\n")
    return 0


# ------------------------------------------------------------------ html
def cmd_html(args):
    with gzip.open(args.payload, "rt") as fh:
        payload = json.load(fh)
    if args.limit:
        payload["folders"] = payload["folders"][:args.limit]
        payload["build"] += f"-first{args.limit}"
    data = json.dumps(payload, separators=(",", ":")).replace("</", "<\\/")
    html = TEMPLATE.replace("__PAYLOAD__", data).replace("__BUILD__", payload["build"])
    out = args.out if os.path.isabs(args.out) else os.path.join(ROOT, args.out)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(html)
    sys.stderr.write(f"wrote {out}: {len(payload['folders'])} folders, {os.path.getsize(out) / 1e6:.1f} MB\n")
    return 0


TEMPLATE = r"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Folder queries</title>
<style>
:root{--bg:#f6f5f2;--card:#fff;--ink:#1d1d1b;--mute:#6b6a66;--line:#dcdad4;--pic:#2f6fb3;--doc:#b3562f;--bad:#b42318;--ok:#2e7d32}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{position:sticky;top:0;z-index:5;background:#fffdf8;border-bottom:1px solid var(--line);padding:10px 16px;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
header h1{font-size:16px;margin:0 8px 0 0}
.count{font-variant-numeric:tabular-nums;color:var(--mute)}
.bar{flex:1;min-width:120px;height:6px;background:var(--line);border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--ok);width:0}
button,.btn{font:inherit;border:1px solid var(--line);background:#fff;border-radius:6px;padding:6px 12px;cursor:pointer}
button:hover{border-color:#999}
button.primary{background:var(--ink);color:#fff;border-color:var(--ink)}
button:disabled{opacity:.45;cursor:default}
input[type=text]{font:inherit;padding:5px 8px;border:1px solid var(--line);border-radius:6px;width:160px}
main{max-width:1180px;margin:0 auto;padding:16px}
.rules{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin-bottom:14px}
.rules summary{cursor:pointer;font-weight:600}
.rules ul{margin:8px 0 2px 18px;padding:0}
.targets{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media (max-width:820px){.targets{grid-template-columns:1fr}}
.target{background:var(--card);border:2px solid var(--line);border-radius:10px;padding:12px}
.target.pic{border-color:var(--pic)} .target.doc{border-color:var(--doc)}
.target h2{font-size:15px;margin:0 0 8px}
.target.pic h2{color:var(--pic)} .target.doc h2{color:var(--doc)}
.preview{display:flex;align-items:center;justify-content:center;min-height:120px;background:#faf9f6;border-radius:6px;padding:8px;margin-bottom:8px}
.preview img{max-width:100%;max-height:320px}
.preview .txt{font:13px/1.45 ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-word;width:100%}
textarea{width:100%;font:inherit;padding:8px;border:1px solid var(--line);border-radius:6px;min-height:64px;resize:vertical}
textarea.bad{border-color:var(--bad)}
.msg{min-height:20px;font-size:13px;color:var(--bad)}
.msg.okm{color:var(--ok)}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:4px}
.skip{font-size:13px;color:var(--mute);background:none;border:none;text-decoration:underline;padding:0}
.nav{display:flex;gap:10px;justify-content:space-between;align-items:center;margin:14px 0}
.folder h3{font-size:14px;margin:18px 0 8px;color:var(--mute);font-weight:600}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px}
.file{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:6px;font-size:12px}
.file.t-pic{outline:3px solid var(--pic)} .file.t-doc{outline:3px solid var(--doc)}
.file img{width:100%;height:150px;object-fit:contain;background:#faf9f6;border-radius:4px}
.file .txt{font:11px/1.35 ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-word;max-height:150px;overflow:auto}
.file .lab{color:var(--mute);margin-top:4px}
.done{color:var(--ok);font-weight:600}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;align-items:center;justify-content:center;z-index:9}
.overlay .box{background:#fff;border-radius:10px;padding:20px;max-width:440px}
</style>
</head>
<body>
<header>
  <h1>Folder queries</h1>
  <span class="count" id="where"></span>
  <div class="bar"><i id="barfill"></i></div>
  <span class="count" id="tally"></span>
  <label>Your name <input type="text" id="writer" placeholder="name"></label>
  <button id="exportBtn" title="Download every query written so far">Export</button>
  <label class="btn" title="Load an exported file to carry on where it stopped">Resume from file<input type="file" id="importFile" accept=".jsonl,.txt" hidden></label>
</header>
<main>
<details class="rules" open>
<summary>How to write the queries</summary>
<ul>
<li>Each folder shows two marked files: a <b style="color:var(--pic)">picture</b> and a <b style="color:var(--doc)">document</b>. Below them is everything else in the folder.</li>
<li>For each marked file, write what you would type into a search box to find that file again later. Describe the marked file, not the folder as a whole.</li>
<li>No digits. No file names. Do not copy more than four words in a row from anything shown.</li>
<li>If a marked file is blank or cannot be read, press "Can't describe this one" and another file is marked.</li>
<li>Your work is kept in this browser as you go. Press Export at any time to save it to a file; send that file back when you finish or stop.</li>
<li>Ctrl+Enter moves to the next folder.</li>
</ul>
</details>
<div id="app"></div>
<div class="nav">
  <button id="prevBtn">&larr; Previous</button>
  <button id="firstOpen">First unfinished</button>
  <button id="nextBtn" class="primary">Next folder &rarr;</button>
</div>
</main>
<div class="overlay" id="overlay"><div class="box" id="overlayBox"></div></div>
<script id="payload" type="application/json">__PAYLOAD__</script>
<script>
(function(){
"use strict";
var P = JSON.parse(document.getElementById("payload").textContent);
var BUILD = "__BUILD__";
var KEY = "dirvec-humanq-" + BUILD;
var F = P.folders;
var state = {i: 0, writer: "", q: {}};
// state.q[folderKey] = {QI: {text, idx, skipped:[]}, QT: {...}}

function load() {
  try { var s = localStorage.getItem(KEY); if (s) { var o = JSON.parse(s); if (o && o.q) state = o; } } catch (e) {}
}
function save() {
  try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
}
function entry(f, kind) {
  var e = state.q[f.key] = state.q[f.key] || {};
  if (!e[kind]) e[kind] = {text: "", idx: 0, skipped: []};
  return e[kind];
}
function words(s) { return (s.toLowerCase().match(/[\p{L}\p{N}_]+/gu) || []); }
function shownText(f) {
  var t = [];
  f.files.forEach(function (x) { if (x.text) t.push(x.text); });
  return t.join(" \n ");
}
var gramCache = {};
function grams(f) {
  if (gramCache[f.key]) return gramCache[f.key];
  var w = words(shownText(f)), g = {};
  for (var i = 0; i + 5 <= w.length; i++) g[w.slice(i, i + 5).join(" ")] = 1;
  return (gramCache[f.key] = g);
}
function check(f, text) {
  var t = text.trim();
  if (!t) return {ok: false, msg: ""};
  if (/\d/.test(t)) return {ok: false, msg: "No digits, please (write numbers out or leave them out)."};
  var w = words(t), g = grams(f);
  for (var i = 0; i + 5 <= w.length; i++) {
    var k = w.slice(i, i + 5).join(" ");
    if (g[k]) return {ok: false, msg: "Copied from the folder: “" + k + "”. Use your own words."};
  }
  if ((t.match(/\p{L}/gu) || []).length < 3) return {ok: false, msg: "Too short."};
  return {ok: true, msg: ""};
}
function fileByKey(f, k) { for (var j = 0; j < f.files.length; j++) if (f.files[j].key === k) return f.files[j]; return null; }
function currentTarget(f, kind) {
  var e = entry(f, kind), list = f[kind];
  return e.idx < list.length ? list[e.idx] : null;
}
function folderStatus(f) {
  var st = {};
  ["QI", "QT"].forEach(function (kind) {
    var e = (state.q[f.key] || {})[kind];
    var exhausted = e && e.idx >= f[kind].length;
    st[kind] = exhausted ? "none" : (e && e.text && check(f, e.text).ok ? "done" : "open");
  });
  st.complete = st.QI !== "open" && st.QT !== "open";
  return st;
}
function tally() {
  var done = 0, nq = 0;
  F.forEach(function (f) { var s = folderStatus(f); if (s.complete) done++; if (s.QI === "done") nq++; if (s.QT === "done") nq++; });
  return {done: done, nq: nq};
}
function el(tag, cls, html) { var e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; }
function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return {"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]; }); }
function preview(file, big) {
  var box = el("div", "preview");
  if (!file) { box.textContent = "No file of this kind is left in this folder."; return box; }
  if (file.img) { var im = new Image(); im.src = file.img; im.alt = file.label; box.appendChild(im); }
  else { box.appendChild(el("div", "txt", esc(file.text))); }
  return box;
}
function render() {
  var f = F[state.i], app = document.getElementById("app");
  app.innerHTML = "";
  var t = tally();
  document.getElementById("where").textContent = "Folder " + (state.i + 1) + " of " + F.length;
  document.getElementById("tally").textContent = t.done + " folders done, " + t.nq + " queries";
  document.getElementById("barfill").style.width = (100 * t.done / F.length) + "%";
  var tg = el("div", "targets");
  [["QI", "pic", "The picture"], ["QT", "doc", "The document"]].forEach(function (k) {
    var kind = k[0], e = entry(f, kind), key = currentTarget(f, kind), file = key ? fileByKey(f, key) : null;
    var card = el("div", "target " + k[1]);
    card.appendChild(el("h2", null, k[2] + (file ? ' <span style="font-weight:400;color:var(--mute)">(' + esc(file.label) + ")</span>" : "")));
    card.appendChild(preview(file, true));
    if (file) {
      var ta = el("textarea"); ta.value = e.text; ta.placeholder = "What would you type to find this file again?";
      var msg = el("div", "msg");
      var upd = function () {
        e.text = ta.value; var c = check(f, ta.value);
        ta.classList.toggle("bad", !!c.msg); msg.textContent = c.msg; msg.className = "msg";
        if (c.ok) { msg.textContent = "Saved."; msg.className = "msg okm"; }
        save(); updateNav();
        var tt = tally();
        document.getElementById("tally").textContent = tt.done + " folders done, " + tt.nq + " queries";
        document.getElementById("barfill").style.width = (100 * tt.done / F.length) + "%";
      };
      ta.addEventListener("input", upd);
      card.appendChild(ta); card.appendChild(msg);
      var row = el("div", "row");
      var sk = el("button", "skip", "Can't describe this one");
      sk.addEventListener("click", function () {
        if (e.text.trim() && !confirm("Drop what you wrote and mark another file?")) return;
        e.skipped.push(key); e.idx += 1; e.text = ""; save(); render();
      });
      row.appendChild(sk); card.appendChild(row);
      setTimeout(function () { var c = check(f, ta.value); ta.classList.toggle("bad", !!c.msg); msg.textContent = c.ok ? "Saved." : c.msg; msg.className = c.ok ? "msg okm" : "msg"; }, 0);
    }
    tg.appendChild(card);
  });
  app.appendChild(tg);
  var fold = el("div", "folder");
  fold.appendChild(el("h3", null, "Everything in this folder (" + f.files.length + " files, in no particular order)"));
  var grid = el("div", "grid");
  var tQI = currentTarget(f, "QI"), tQT = currentTarget(f, "QT");
  f.files.forEach(function (x) {
    var c = el("div", "file" + (x.key === tQI ? " t-pic" : x.key === tQT ? " t-doc" : ""));
    if (x.img) { var im = new Image(); im.loading = "lazy"; im.src = x.img; im.alt = x.label; c.appendChild(im); }
    else c.appendChild(el("div", "txt", esc(x.text)));
    c.appendChild(el("div", "lab", esc(x.label) + (x.key === tQI ? " &middot; marked picture" : x.key === tQT ? " &middot; marked document" : "")));
    grid.appendChild(c);
  });
  fold.appendChild(grid); app.appendChild(fold);
  updateNav();
  save();
}
function updateNav() {
  document.getElementById("prevBtn").disabled = state.i === 0;
  var s = folderStatus(F[state.i]);
  var nb = document.getElementById("nextBtn");
  nb.disabled = !s.complete || state.i === F.length - 1;
  nb.textContent = state.i === F.length - 1 ? "Last folder" : "Next folder →";
}
function go(i) { state.i = Math.max(0, Math.min(F.length - 1, i)); render(); window.scrollTo(0, 0); }
document.getElementById("prevBtn").addEventListener("click", function () { go(state.i - 1); });
document.getElementById("nextBtn").addEventListener("click", function () { if (folderStatus(F[state.i]).complete) go(state.i + 1); });
document.getElementById("firstOpen").addEventListener("click", function () {
  for (var j = 0; j < F.length; j++) if (!folderStatus(F[j]).complete) { go(j); return; }
  go(F.length - 1);
});
document.addEventListener("keydown", function (ev) {
  if ((ev.ctrlKey || ev.metaKey) && ev.key === "Enter") { ev.preventDefault(); if (folderStatus(F[state.i]).complete) go(state.i + 1); }
});
var wr = document.getElementById("writer");
wr.addEventListener("input", function () { state.writer = wr.value.trim(); save(); });
function exportLines() {
  var lines = [];
  F.forEach(function (f) {
    ["QI", "QT"].forEach(function (kind) {
      var e = (state.q[f.key] || {})[kind];
      if (!e) return;
      var key = e.idx < f[kind].length ? f[kind][e.idx] : null;
      var ok = key && e.text && check(f, e.text).ok;
      if (!ok) return;
      lines.push(JSON.stringify({build: BUILD, folder: f.key, kind: kind, target: key, query: e.text.trim(),
        writer: state.writer, skipped: e.skipped.slice()}));
    });
  });
  return lines;
}
document.getElementById("exportBtn").addEventListener("click", function () {
  if (!state.writer) { alert("Please type your name first (top right)."); wr.focus(); return; }
  var lines = exportLines();
  var blob = new Blob([lines.join("\n") + (lines.length ? "\n" : "")], {type: "application/jsonl"});
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "humanq_s11.jsonl";
  document.body.appendChild(a); a.click();
  setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  var t = tally();
  showBox("Exported " + lines.length + " queries from " + t.done + " finished folders to <b>humanq_s11.jsonl</b> in your downloads.");
});
document.getElementById("importFile").addEventListener("change", function (ev) {
  var file = ev.target.files[0]; if (!file) return;
  var rd = new FileReader();
  rd.onload = function () {
    var n = 0, bad = 0;
    String(rd.result).split(/\r?\n/).forEach(function (line) {
      if (!line.trim()) return;
      try {
        var o = JSON.parse(line), f = null;
        for (var j = 0; j < F.length; j++) if (F[j].key === o.folder) f = F[j];
        if (!f || (o.kind !== "QI" && o.kind !== "QT")) { bad++; return; }
        var idx = f[o.kind].indexOf(o.target);
        if (idx < 0) { bad++; return; }
        state.q[f.key] = state.q[f.key] || {};
        state.q[f.key][o.kind] = {text: o.query, idx: idx, skipped: o.skipped || []};
        if (o.writer && !state.writer) state.writer = o.writer;
        n++;
      } catch (e) { bad++; }
    });
    wr.value = state.writer || "";
    save();
    document.getElementById("firstOpen").click();
    showBox("Loaded " + n + " queries" + (bad ? " (" + bad + " lines not recognised)" : "") + ".");
  };
  rd.readAsText(file);
  ev.target.value = "";
});
function showBox(html) {
  var o = document.getElementById("overlay");
  document.getElementById("overlayBox").innerHTML = html + '<div style="margin-top:14px;text-align:right"><button id="okBox" class="primary">OK</button></div>';
  o.style.display = "flex";
  document.getElementById("okBox").onclick = function () { o.style.display = "none"; };
}
window.__humanq = {state: function () { return state; }, exportLines: exportLines, check: function (i, t) { return check(F[i], t); }, n: F.length};
load();
wr.value = state.writer || "";
if (state.i >= F.length) state.i = 0;
render();
})();
</script>
</body>
</html>
"""


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("sample")
    s.add_argument("--index", required=True, help="E1=<index.jsonl>,E2=...,E3=...,E4=...")
    s.add_argument("--manifest", default="data/manifest_s11.jsonl")
    s.add_argument("--dirs", default="data/dirs_s11.jsonl")
    s.add_argument("--gt", default="data/gt_structural_s11.jsonl")
    s.add_argument("--selection", default="data/selection_s11.jsonl")
    s.add_argument("--out", default="data/humanq_sample_s11.jsonl")
    s.add_argument("--check", action="store_true")
    pl = sub.add_parser("payload")
    pl.add_argument("--sample", default="data/humanq_sample_s11.jsonl")
    pl.add_argument("--manifest", default="data/manifest_s11.jsonl")
    pl.add_argument("--selection", default="data/selection_s11.jsonl")
    pl.add_argument("--out", default="build/humanq/payload_s11.json.gz")
    h = sub.add_parser("html")
    h.add_argument("--payload", default="build/humanq/payload_s11.json.gz")
    h.add_argument("--out", default="build/humanq/humanq_s11.html")
    h.add_argument("--limit", type=int, default=0)
    args = ap.parse_args()
    for k in ("manifest", "dirs", "gt", "selection", "sample", "payload"):
        v = getattr(args, k, None)
        if v and not os.path.isabs(v):
            setattr(args, k, os.path.join(ROOT, v))
    sys.exit({"sample": cmd_sample, "payload": cmd_payload, "html": cmd_html}[args.cmd](args))


if __name__ == "__main__":
    main()
